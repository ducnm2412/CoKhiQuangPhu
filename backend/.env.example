# Sao chép thành backend/.env khi chạy máy; trên Render/Railway khai báo trong mục Environment.

PORT=4000
# Domain frontend được phép gọi API (cách nhau bằng dấu phẩy)
CORS_ORIGIN="http://localhost:3000"

# MongoDB Atlas: Database → Connect → Drivers. Nhớ mở Network Access cho IP của server.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="cokhi"

# Cloudinary: Dashboard → API Keys → "API environment variable"
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_FOLDER="cokhi/news"

# Google Cloud Translation (tuỳ chọn, cho nút "Dịch sang tiếng Anh" ở trang quản trị):
# Console → APIs & Services → bật "Cloud Translation API" → Credentials → Create API key
GOOGLE_TRANSLATE_API_KEY=""

# Đăng nhập quản trị (không khai báo ADMIN_USERNAME thì mặc định là "admin")
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="doi-mat-khau-nay"
# Chuỗi ngẫu nhiên ≥ 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

GOOGLE_TRANSLATE_API_KEY=""