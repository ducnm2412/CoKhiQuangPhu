{
  "name": "cokhi",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n be,fe -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:fe": "npm run dev -w frontend",
    "dev:be": "npm run dev -w backend",
    "build:fe": "npm run build -w frontend",
    "build:be": "npm run build -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
